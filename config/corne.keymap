#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <18 19 20 21 22 30 31 32 33 9 8 7 34>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <14 15 16 17 13>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        Lock {
            bindings = <&kp C_AL_SCREENSAVER>;
            key-positions = <11 10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE    &kp Q         &kp W            &kp E            &kp R              &kp T        &kp Y    &kp U               &kp I             &kp O             &kp P            &kp BACKSPACE
&kp CAPSLOCK  &HML LCTRL A  &HML LEFT_ALT S  &HML LEFT_GUI D  &HML LEFT_SHIFT F  &kp G        &kp H    &HMR RIGHT_SHIFT J  &HMR RIGHT_GUI K  &HMR RIGHT_ALT L  &HMR RCTRL SEMI  &kp SQT
&kp GRAVE     &kp Z         &kp X            &kp C            &kp V              &kp B        &kp N    &kp M               &kp COMMA         &kp DOT           &kp FSLH         &kp F5
                                             &tog 2           &mo 2              &kp SPACE    &kp RET  &mo 1               &tog 1
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans        &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp C_AC_SEARCH  &kp F6        &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
&trans        &trans                &trans                &trans                             &trans           &trans        &kp MINUS       &kp EQUAL         &kp LBKT    &kp RBKT    &kp BSLH           &kp GRAVE
&bt BT_SEL 0  &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3                       &bt BT_SEL 4     &bt BT_CLR    &kp UNDER       &kp PLUS          &kp LBRC    &kp RBRC    &kp PIPE           &kp TILDE
                                                          &trans                             &trans           &kp SPACE     &kp RET         &trans            &trans
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &trans          &kp UP_ARROW    &trans           &trans  &trans       &trans                              &HMR EXCLAMATION KP_NUMBER_1  &HMR AT_SIGN KP_NUMBER_2   &HMR POUND KP_NUMBER_3             &trans                              &trans
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans       &trans                              &HMR DOLLAR KP_NUMBER_4       &HMR PERCENT KP_NUMBER_5   &HMR CARET KP_NUMBER_6             &trans                              &trans
&trans  &trans          &trans          &trans           &trans  &trans       &HMR RIGHT_PARENTHESIS KP_NUMBER_0  &HMR AMPERSAND KP_NUMBER_7    &HMR ASTERISK KP_NUMBER_8  &HMR LEFT_PARENTHESIS KP_NUMBER_9  &HMR RIGHT_PARENTHESIS KP_NUMBER_0  &trans
                                        &trans           &trans  &kp SPACE    &kp RET                             &trans                        &trans
            >;
        };
    };
};
